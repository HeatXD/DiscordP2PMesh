    <ClCompile Include="thirdparty\libjuice\src\conn_mux.c" />
    <ClCompile Include="thirdparty\libjuice\src\conn_poll.c" />
    <ClCompile Include="thirdparty\libjuice\src\conn_thread.c" />
    <ClCompile Include="thirdparty\libjuice\src\const_time.c" />
    <ClCompile Include="thirdparty\libjuice\src\crc32.c" />
    <ClCompile Include="thirdparty\libjuice\src\hash.c" />
    <ClCompile Include="thirdparty\libjuice\src\hmac.c" />
    <ClCompile Include="thirdparty\libjuice\src\ice.c" />
    <ClCompile Include="thirdparty\libjuice\src\juice.c" />
    <ClCompile Include="thirdparty\libjuice\src\log.c" />
    <ClCompile Include="thirdparty\libjuice\src\random.c" />
    <ClCompile Include="thirdparty\libjuice\src\server.c" />
    <ClCompile Include="thirdparty\libjuice\src\stun.c" />
    <ClCompile Include="thirdparty\libjuice\src\tcp.c" />
    <ClCompile Include="thirdparty\libjuice\src\timestamp.c" />
    <ClCompile Include="thirdparty\libjuice\src\turn.c" />
    <ClCompile Include="thirdparty\libjuice\src\udp.c" />
  </ItemGroup>
  <ItemGroup>
